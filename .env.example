# Copy this file to .env.local and add public Supabase browser values.
# Never add a service-role key to Vite or commit a real .env.local file.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY
# Optional: a monitored address shown on the Privacy Notice for POPIA requests.
VITE_PRIVACY_CONTACT_EMAIL=privacy@your-domain.co.za